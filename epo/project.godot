; Fichier de configuration du projet Godot.
config_version=5

[application]

config/name="EPO"
config/description="EPO — L'histoire de la guerre, de l'ingénierie à la stratégie."
config/version="0.1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.07, 0.08, 0.06, 1)
boot_splash/show_image=false

[autoload]

Content="*res://core/content.gd"
Game="*res://core/game.gd"
UI="*res://core/ui.gd"
Sfx="*res://core/sfx.gd"
Nav="*res://core/nav.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
